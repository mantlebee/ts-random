{
  "name": "@mantlebee/ts-random",
  "version": "1.0.0",
  "description": "Utility functions to generate random data.",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./arrays": {
      "import": {
        "types": "./dist/esm/arrays/index.d.mts",
        "default": "./dist/esm/arrays/index.mjs"
      },
      "require": {
        "types": "./dist/src/arrays/index.d.ts",
        "default": "./dist/arrays/index.js"
      }
    },
    "./booleans": {
      "import": {
        "types": "./dist/esm/booleans/index.d.mts",
        "default": "./dist/esm/booleans/index.mjs"
      },
      "require": {
        "types": "./dist/src/booleans/index.d.ts",
        "default": "./dist/booleans/index.js"
      }
    },
    "./colors": {
      "import": {
        "types": "./dist/esm/colors/index.d.mts",
        "default": "./dist/esm/colors/index.mjs"
      },
      "require": {
        "types": "./dist/src/colors/index.d.ts",
        "default": "./dist/colors/index.js"
      }
    },
    "./dates": {
      "import": {
        "types": "./dist/esm/dates/index.d.mts",
        "default": "./dist/esm/dates/index.mjs"
      },
      "require": {
        "types": "./dist/src/dates/index.d.ts",
        "default": "./dist/dates/index.js"
      }
    },
    "./numbers": {
      "import": {
        "types": "./dist/esm/numbers/index.d.mts",
        "default": "./dist/esm/numbers/index.mjs"
      },
      "require": {
        "types": "./dist/src/numbers/index.d.ts",
        "default": "./dist/numbers/index.js"
      }
    },
    "./passwords": {
      "import": {
        "types": "./dist/esm/passwords/index.d.mts",
        "default": "./dist/esm/passwords/index.mjs"
      },
      "require": {
        "types": "./dist/src/passwords/index.d.ts",
        "default": "./dist/passwords/index.js"
      }
    },
    "./secure": {
      "import": {
        "types": "./dist/esm/secure/index.d.mts",
        "default": "./dist/esm/secure/index.mjs"
      },
      "require": {
        "types": "./dist/src/secure/index.d.ts",
        "default": "./dist/secure/index.js"
      }
    },
    "./strings": {
      "import": {
        "types": "./dist/esm/strings/index.d.mts",
        "default": "./dist/esm/strings/index.mjs"
      },
      "require": {
        "types": "./dist/src/strings/index.d.ts",
        "default": "./dist/strings/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "arrays": [
        "./dist/src/arrays/index.d.ts"
      ],
      "booleans": [
        "./dist/src/booleans/index.d.ts"
      ],
      "colors": [
        "./dist/src/colors/index.d.ts"
      ],
      "dates": [
        "./dist/src/dates/index.d.ts"
      ],
      "numbers": [
        "./dist/src/numbers/index.d.ts"
      ],
      "passwords": [
        "./dist/src/passwords/index.d.ts"
      ],
      "secure": [
        "./dist/src/secure/index.d.ts"
      ],
      "strings": [
        "./dist/src/strings/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup --config && tsc-alias && node scripts/emit-esm-types.mjs",
    "coverage": "jest --coverage --collectCoverageFrom='./src/**'",
    "doc": "typedoc",
    "doc:publish": "npm run doc && node ./gh-pages.js",
    "format": "prettier --write src scripts docs .github README.md \"*.{js,mjs,json}\"",
    "format:check": "prettier --check src scripts docs .github README.md \"*.{js,mjs,json}\"",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantlebee/ts-random.git"
  },
  "keywords": [
    "typescript",
    "random",
    "faker",
    "mock",
    "password",
    "test-data"
  ],
  "author": "MantleBee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mantlebee/ts-random/issues"
  },
  "homepage": "https://github.com/mantlebee/ts-random#readme",
  "engines": {
    "node": ">=19"
  },
  "peerDependencies": {
    "@mantlebee/ts-core": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mantlebee/ts-core": "^1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "eslint": "10.13.0",
    "gh-pages": "6.3.0",
    "jest": "30.5.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.3",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
