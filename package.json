{
  "name": "@mantlebee/ts-random",
  "version": "1.0.0",
  "description": "Utility functions to generate random data.",
  "main": "dist/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup --config && tsc-alias && node scripts/emit-esm-types.mjs",
    "coverage": "jest --coverage --collectCoverageFrom='./src/**'",
    "doc": "typedoc",
    "doc:publish": "npm run doc && node ./gh-pages.js",
    "format": "prettier --write src scripts docs README.md \"*.{js,mjs,json}\"",
    "format:check": "prettier --check src scripts docs README.md \"*.{js,mjs,json}\"",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantlebee/ts-random.git"
  },
  "keywords": [
    "typescript",
    "random",
    "faker",
    "mock",
    "password",
    "test-data"
  ],
  "author": "MantleBee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mantlebee/ts-random/issues"
  },
  "homepage": "https://github.com/mantlebee/ts-random#readme",
  "engines": {
    "node": ">=19"
  },
  "peerDependencies": {
    "@mantlebee/ts-core": "^1.0.0"
  },
  "devDependencies": {
    "@mantlebee/ts-core": "^1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "gh-pages": "6.3.0",
    "jest": "30.5.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.3",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
